diff --git a/node_modules/expo-sharing/android/src/main/java/expo/modules/sharing/SharingModule.kt b/node_modules/expo-sharing/android/src/main/java/expo/modules/sharing/SharingModule.kt
index 4be45fe..a6ca6b5 100644
--- a/node_modules/expo-sharing/android/src/main/java/expo/modules/sharing/SharingModule.kt
+++ b/node_modules/expo-sharing/android/src/main/java/expo/modules/sharing/SharingModule.kt
@@ -65,6 +65,29 @@ class SharingModule : Module() {
         pendingPromise = null
       }
     }
+
+    // ── A share that never got its result must not wedge every later one ──
+    //
+    // Reported as: shared a file to WhatsApp (fine), tried a second (the app
+    // crashed), and from then on every share failed with "Another share
+    // request is being processed now" — permanently, until the app was
+    // force-stopped.
+    //
+    // pendingPromise is cleared in exactly one place, OnActivityResult above.
+    // When that result never arrives the field stays set for the life of the
+    // module, and shareAsync throws before it does anything. The result does
+    // not always arrive: the activity can be destroyed and recreated while the
+    // chooser is up, which is what a crash in the middle of sharing looks
+    // like, and the recreated activity is not the one the result was going to.
+    //
+    // Being back in the foreground means the chooser is gone. Whatever it did,
+    // the share this promise belongs to is over, so the promise is settled and
+    // the next share can start. If the real result arrives first it clears the
+    // field and this does nothing.
+    OnActivityEntersForeground {
+      pendingPromise?.resolve(null)
+      pendingPromise = null
+    }
   }
 
   @Throws(InvalidArgumentException::class)
