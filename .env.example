# Copy to .env for local runs (never commit .env).
# In GitHub Actions these are set as repository Secrets instead.

# Claude API key — create at https://platform.claude.com (Settings -> API keys).
# Note: this is separate from the Claude Pro subscription; one post/day costs cents/month.
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheet published as CSV:
# File -> Share -> Publish to web -> select the sheet + CSV -> copy link.
# Columns: name, price (header row optional).
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# Instagram Graph API (Business/Creator account required — see README).
IG_USER_ID=1784...
IG_ACCESS_TOKEN=IGQ...

# Telegram bot (create with @BotFather) and target channel.
# TELEGRAM_CHANNEL_ID can be @yourchannelname or the numeric -100... id.
# The bot must be an admin of the channel.
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHANNEL_ID=@your_channel

# DRAFT MODE (recommended at first): when set, posts go to this chat instead
# of the channel so you can review them. Use your own numeric chat id
# (message @userinfobot on Telegram to get it). Leave empty to post directly.
TELEGRAM_DRAFT_CHAT_ID=

# Optional overrides
# CAPTION_LANGUAGE=Persian
# CLIP_SECONDS=12
# CLAUDE_MODEL=claude-opus-4-8
